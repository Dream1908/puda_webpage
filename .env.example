COMPOSE_PROJECT_NAME=puda-webpage
WANTED_UID=1000
WANTED_GID=1000
HERMES_WEBUI_HOST=0.0.0.0
HERMES_WEBUI_PORT=8787
HERMES_WEBUI_STATE_DIR=/home/hermeswebui/.hermes/webui

# Optional host-path overrides:
# HOST_HERMES_HOME=/path/to/.hermes
# HOST_HERMES_WORKSPACE=/path/to/workspace

# Required if the port is exposed beyond 127.0.0.1:
# HERMES_WEBUI_PASSWORD=replace-with-a-strong-password
